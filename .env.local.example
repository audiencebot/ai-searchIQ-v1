# ─────────────────────────────────────────────────────────────────────────────
# AI Search IQ — LOCAL DEV environment template.
# Copy to .env and fill in. NEVER commit a real .env. NEVER point DATABASE_URL
# at the platform database (*.privatelink.aliyuncs.com) — the local DB is a
# disposable sandbox.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ─────────────────────────────────────────────────────────────────
# Platform application ID. For local dev any value works; it is embedded in
# the session JWT as clientId.
APP_ID=local-dev-app
# Secret used to sign session JWTs. Any random string is fine locally
# (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
APP_SECRET=local-dev-secret-change-me

# ── Database ────────────────────────────────────────────────────────────────
# Local MySQL 8 (see docs/LOCAL_DEV.md step 2). Adjust user/password/db to
# match your install. TiDB Cloud Serverless also works (append its TLS query
# params as given by the TiDB console and pass --allow-remote to the setup
# script).
DATABASE_URL=mysql://root:root@localhost:3306/aisearchiq

# ── Local dev login (LOCAL ONLY — never set on the deployed platform) ───────
# Enables GET /api/dev-login and the http://localhost:3000/dev-login page.
# When unset, the route returns 404 and does not exist.
DEV_LOGIN_KEY=changeme-local-only

# ── Frontend (exposed to browser via Vite) ──────────────────────────────────
# Kimi OAuth is NOT usable on localhost (redirect allow-list); dev login above
# replaces it. These are kept so the app boots without warnings.
VITE_KIMI_AUTH_URL=https://auth.kimi.com
VITE_APP_ID=local-dev-app

# ── Backend (Auth) ──────────────────────────────────────────────────────────
# Same note: only used by the real Kimi OAuth flow, which is unused locally.
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com

# ── Admin Role ──────────────────────────────────────────────────────────────
# Union ID treated as the app owner. scripts/local-db-setup.ts creates a local
# user with this unionId and role "admin"; /api/dev-login signs in as that user.
OWNER_UNION_ID=local-dev-owner

# ── Integration credentials (OPTIONAL locally) ──────────────────────────────
# Only needed if you exercise the Settings integrations locally. Leave blank
# otherwise — the portal runs fine without them.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_GA4_CLIENT_ID=
GOOGLE_GA4_CLIENT_SECRET=
GOOGLE_GBP_CLIENT_ID=
GOOGLE_GBP_CLIENT_SECRET=
GOOGLE_GSC_CLIENT_ID=
GOOGLE_GSC_CLIENT_SECRET=
GOOGLE_INDEXING_SA_EMAIL=
GOOGLE_INDEXING_SA_KEY_PATH=.secrets/google-sa-webindexing.json
GOOGLE_INDEXING_API_KEY=
PAGESPEED_API_KEY=

# ── Transactional email — Resend (HQ onboarding + report notifications) ─────
# HTTP API key from resend.com. When EMPTY the app still runs: every send is
# logged in email_log with status 'pending' and HQ shows it as undelivered.
RESEND_API_KEY=
# Sender identity (must be a verified domain in Resend). Display name + address.
EMAIL_FROM=AI Search IQ <reports@aisearchiq.net>
# Staff notification inbox for HQ payment & review alerts (Phase 1.5).
# Defaults to hello@aisearchiq.net when unset.
# STAFF_NOTIFY_EMAIL=hello@aisearchiq.net
